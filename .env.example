# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# APP_SECRET_KEY: Optional 32-character master key for encrypting API keys at rest.
APP_SECRET_KEY=

# ─── Telegram Cross-Device Bridge ─────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN: Get this from @BotFather on Telegram.
# If not set, the Telegram bridge is disabled and the server starts normally.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_ALLOWED_CHAT_ID: Security whitelist — Mohit's personal chat ID.
# Find your chat ID by messaging @userinfobot on Telegram.
# Leave empty to allow all users (not recommended for personal bots).
# Supports comma-separated list for multiple allowed IDs: 123456,789012
TELEGRAM_ALLOWED_CHAT_ID=

# ─── Voice Note Transcription ─────────────────────────────────────────────────
# OPENAI_WHISPER_KEY: Optional OpenAI API key for Whisper voice transcription.
# If not set, voice notes use Gemini audio transcription (via GEMINI_API_KEY).
# If neither is set, voice notes return a friendly fallback message.
OPENAI_WHISPER_KEY=

# ─── Web Search Providers (any one required for web_search tool) ───────────────
# TAVILY_API_KEY=
# SERPER_API_KEY=
# SERPAPI_API_KEY=
# BRAVE_SEARCH_API_KEY=

# VITE_ELEVENLABS_API_KEY=

# ─── IoT Hardware Integration ──────────────────────────────────────────────────
# SMART_GATE_ENDPOINT: The HTTP endpoint of the ESP32 relay controlling the physical gate.
# Example: http://192.168.1.50/gate
# If empty, the gate tool simulates a failure cleanly without crashing.
SMART_GATE_ENDPOINT=

# SMART_GATE_AUTH_TOKEN: Optional Bearer token if the ESP32 requires authentication.
SMART_GATE_AUTH_TOKEN=

# RADAR_SENSOR_SECRET: Optional HMAC secret for validating ESP32 webhook payloads.
# Leave empty for local development (accepts all payloads).
RADAR_SENSOR_SECRET=